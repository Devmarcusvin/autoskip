
{
  "manifest_version": 3,
  "name": "AutoSkip",
  "version": "0.2.0",
  "description": "Pula automaticamente aberturas em plataformas de streaming.",

  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.netflix.com/*",
        "https://*.hbomax.com/*"      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}